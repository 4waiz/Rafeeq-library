# ROS 2 / colcon build artifacts
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Runtime detection images. These are REQUIRED EVIDENCE, so they are kept -
# the previous rule excluded exactly what the rulebook asks to be submitted.
# Only the scratch captures from ad-hoc debugging are ignored.
erc_images/scratch/

# Trial logs are kept: they are about 20 KB each and they are the fullest
# evidence of what a run actually did, alongside the machine-readable records.
# Terminal colour codes are stripped before committing so they read as text.

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
